// Configuration of the render-based tracker (vpRBTracker) used by tutorial-rbt-sequence to track the dragon
// in a pre-recorded color video (no depth):
//   ./tutorial-rbt-sequence --color data/dragon/dragon.mp4 --tracker data/dragon/dragon.json
// See the "JSON configuration" section of the render-based tracking tutorial for the full list of parameters.
{
  // Camera used to acquire the video. Required here since the intrinsics cannot be retrieved from a video file.
  "camera": {
    // Camera intrinsics in pixels. Only "perspectiveWithoutDistortion" is supported.
    "intrinsics": {
      "model": "perspectiveWithoutDistortion",
      // Ratio between the focal length and the pixel width and height.
      "px": 607.178,
      "py": 607.234,
      // Principal point location.
      "u0": 321.391,
      "v0": 241.918
    },
    // Image size in pixels.
    "height": 480,
    "width": 640
  },
  // Settings of the pose optimization (Levenberg-Marquardt).
  "vvs": {
    // Optimization gain. A gain too small may lead to drift, a gain too high to an unstable pose.
    "gain": 1.0,
    // Maximum number of optimization iterations per frame.
    "maxIterations": 10,
    // Initial amount of Levenberg-Marquardt regularization (0 = Gauss-Newton).
    "mu": 0.01,
    // Factor applied to mu at every optimization iteration.
    "muIterFactor": 0.1
  },
  // Path to the 3D model of the object, in a format readable by Panda3D.
  "model": "data/dragon/dragon.bam",
  // Settings of the silhouette extraction from the renders of the 3D model.
  "silhouetteExtractionSettings": {
    // A pixel belongs to the silhouette if the rendered depth disparity is above this threshold.
    // "relative": value is a fraction of the distance between the clipping planes. "absolute": value in meters.
    "threshold": {
      "type": "relative",
      "value": 0.1
    },
    "sampling": {
      // Step in pixels used to sample the silhouette map (1 = every pixel).
      "samplingRate": 1,
      // Maximum number of silhouette points to keep (0 = keep all of them).
      "numPoints": 512,
      // Try to reuse the same silhouette points across frames, to reduce jitter.
      "reusePreviousPoints": true
    }
  },
  // Object segmentation used to filter out the features that do not belong to the object.
  "mask": {
    // Segmentation based on color histograms of the object and of the background.
    "type": "histogram",
    // Number of bins per color component. Should be a power of 2.
    "bins": 32,
    // Update rate of the object and background histograms, in [0, 1] (1 = only use the last frame).
    "objectUpdateRate": 0.1,
    "backgroundUpdateRate": 0.1,
    // Max difference (in meters) between rendered and measured depth for a pixel to update the object histogram.
    // Only used when depth is available.
    "maxDepthError": 0.01,
    // If true, compute the mask only in the bounding box of the object (faster).
    "computeOnlyOnBoundingBox": false
  },
  // Drift detection, used to estimate the confidence in the tracking.
  "drift": {
    // Probabilistic method based on color (and depth, if available) statistics of 3D points sampled on the object.
    "type": "probabilistic",
    // Update rate of the color statistics of each 3D point.
    "colorUpdateRate": 0.25,
    // Initial standard deviation of the (R, G, B) color of each 3D point.
    "initialColorSigma": 25.0,
    // Standard deviation (in meters) between the measured and the rendered depth.
    "depthSigma": 0.025,
    // Max depth error (in meters) to consider that a stored 3D point is visible from the camera.
    "filteringMaxDistance": 0.001,
    // Minimum distance (in meters) between a newly sampled 3D point and the already stored ones.
    "minDistanceNewPoints": 0.005
  },
  // List of the features used to estimate the pose. Each one has a "weight" giving its importance.
  "features": [
    {
      // Silhouette contours tracked using color statistics (Contracting Curve Density, CCD).
      "type": "silhouetteColor",
      "weight": 0.1,
      // Use the segmentation mask to reject features with a confidence below minMaskConfidence.
      "useMask": true,
      "minMaskConfidence": 0.8,
      "ccd": {
        // Initial size (in pixels) of the search area along the contour normal. Drives the convergence domain.
        "h": 32,
        // Subsampling step (in pixels) along the contour normal.
        "delta_h": 2,
        // Minimum size of the search area: h is halved during the optimization down to min_h.
        "min_h": 16
      }
    },
    {
      // KLT keypoints tracked with vpKltOpencv.
      "type": "klt",
      "weight": 1,
      // Use the segmentation mask to reject features with a confidence below minMaskConfidence.
      "useMask": true,
      "minMaskConfidence": 0.5,
      // A tracked point with a reprojection error above this value (in pixels) is rejected.
      "maxReprojectionErrorPixels": 5.0,
      // Minimum distance (in pixels) between a new point and the already tracked ones.
      "newPointsMinPixelDistance": 4,
      // KLT tracking is fully reinitialized when fewer points than this are tracked.
      "minimumNumPoints": 20,
      // Remaining settings are passed to vpKltOpencv:
      // size of the averaging block used to compute the derivatives,
      "blockSize": 5,
      // use the Harris detector (true) or the minimum eigen value detector (false), with its free parameter,
      "useHarris": true,
      "harris": 0.05,
      // maximum number of detected points,
      "maxFeatures": 500,
      // minimum distance (in pixels) between detected corners,
      "minDistance": 5.0,
      // maximum pyramid level (0 = no pyramid),
      "pyramidLevels": 3,
      // minimal accepted quality, as a fraction of the best corner quality,
      "quality": 0.01,
      // and size of the search window used to refine the corner locations.
      "windowSize": 5
    }
  ]
}
